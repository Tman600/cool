{
  "_format": {
    "grid": "Each room is a rectangular grid of tile chars. Cell = 16px. Render tile layer first, then entities/props by their x,y (in tile coords).",
    "legend": {
      "#": "tile_wall (solid)",
      ".": "tile_floor",
      "+": "tile_door (walkable exit; connects to another room via 'exits')",
      "x": "tile_corrupt (walkable but decays; used in branch rooms)",
      ">": "tile_stairs (descend to next room)",
      " ": "empty / void (not drawn, treated solid)"
    },
    "placement_note": "Props and entities are placed by tile coordinate on top of the floor. Torches sit on wall tiles. Rifts, altars, chests, crosses, enemies, npcs all use x,y in tile units from the room's top-left (0,0)."
  },

  "start_room": "cell_of_waking",

